# Optional AI configuration. Copy this file to .env and add your own key locally.
# Never put real API keys in this example file or commit .env.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Sending candidate PII to AI is OFF by default.
AI_ALLOW_PII=false
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_TOKEN=
MAX_FETCH_BYTES=2000000
MAX_FETCH_REDIRECTS=3
JOB_FRESH_DAYS=30